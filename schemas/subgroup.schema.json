{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wpr-education district subgroup data file",
  "description": "Shape of data/subgroups/{dpi_code}.json: the district-file metrics broken out by student group. topics -> topic id -> school year -> dimension id (race_ethnicity, econ_status, disability, el_status) -> group label (verbatim from DPI GROUP_BY_VALUE, except ELL/LEP harmonized to EL) -> metric -> cell. Cells with value null must have suppressed true and vice versa — enforced in pipeline/validate.py.",
  "type": "object",
  "required": ["district", "generated", "topics"],
  "additionalProperties": false,
  "properties": {
    "district": {
      "type": "object",
      "required": ["dpi_code", "dpi_name"],
      "additionalProperties": false,
      "properties": {
        "dpi_code": { "type": "string" },
        "dpi_name": { "type": "string" }
      }
    },
    "generated": {
      "type": "string",
      "description": "ISO 8601 timestamp of the refresh run that produced this file"
    },
    "topics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "propertyNames": {
            "enum": ["race_ethnicity", "econ_status", "disability", "el_status"]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/cell" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "required": ["value", "suppressed"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["number", "null"] },
        "suppressed": { "type": "boolean" }
      }
    }
  }
}
